//@version=6
// Levels spec v1.8 — Phase 1: expected daily range (docs/spec.md §5); Phase 9: weekly COT bias (§6.2). Master copy: github.com/ziash/Levels, pine/Levels.pine
indicator("Levels — expected range", shorttitle = "Levels", overlay = true)

import TradingView/LibraryCOT/6 as cot

// ── Settings (spec §5.4) ─────────────────────────────────────────────────────────────────────
string G_SRC  = "Range source"
string G_SHOW = "Display"
string G_COT  = "Weekly bias (COT)"

string srcMode  = input.string("Auto", "Range source", options = ["Auto", "Implied only", "Historical only"], group = G_SRC,
     tooltip = "Auto: implied where a volatility index is listed and has data, historical otherwise (spec §5.2, §5.3)")
string volList  = input.text_area("US500=CBOE:VIX1D|TVC:VIX\nUSTEC=CBOE:VXN\nNAS100=CBOE:VXN\nXAUUSD=CBOE:GVZ\nXTIUSD=CBOE:OVX\nSPOTCRUDE=CBOE:OVX\nBTCUSD=DERIBIT:DVOL/365\nETHUSD=DERIBIT:ETHDVOL/365",
     "Volatility index per symbol", group = G_SRC,
     tooltip = "One TICKER=INDEX per line. A|B = try A, then B. /365 = the index is annualised over 365 days (crypto) (spec §5.2)")
string volForce = input.string("", "Volatility index (override)", group = G_SRC,
     tooltip = "One index for this chart only, e.g. TVC:VIX or CBOE:GVZ/252; empty = use the list")
int    histDays = input.int(20, "Historical: days", minval = 5, maxval = 250, group = G_SRC)
int    yearDays = input.int(252, "Trading days per year", minval = 200, maxval = 365, group = G_SRC,
     tooltip = "N in σ = index ÷ 100 ÷ √N, unless the list line ends in /N")

bool  show2     = input.bool(true, "Show ±2σ", group = G_SHOW)
bool  showTable = input.bool(true, "Show table", group = G_SHOW)
color colOpen   = input.color(color.gray, "Open", group = G_SHOW)
color col1      = input.color(color.orange, "±1σ", group = G_SHOW)
color col2      = input.color(color.red, "±2σ", group = G_SHOW)

bool   showCot  = input.bool(true, "Show big-money bias (COT)", group = G_COT)
string cotList  = input.text_area("US500=F:13874A\nUSTEC=F:209742\nNAS100=F:209742\nXAUUSD=D:088691\nXAGUSD=D:084691\nXTIUSD=D:067651\nSPOTCRUDE=D:067651\nXNGUSD=D:023651\nXPTUSD=D:076651\nEURUSD=F:099741\nGBPUSD=F:096742\nAUDUSD=F:232741\nUSDJPY=,F:097741\nEURGBP=F:099741,F:096742\nEURJPY=F:099741,F:097741\nGBPJPY=F:096742,F:097741\nAUDJPY=F:232741,F:097741\nBTCUSD=F:133741\nETHUSD=F:146021\nSOLUSD=F:177742",
     "COT market per symbol", group = G_COT,
     tooltip = "TICKER=BASE,QUOTE. A leg is REPORT:CFTC code; F = Financial (TFF), D = Disaggregated. One leg = that market; two legs = a cross scored base − quote; an empty base (USDJPY=,F:097741) = the quote leg turned round (spec §6.2)")
string cotForce = input.string("", "COT market (override)", group = G_COT, tooltip = "For this chart only, e.g. D:088691 or F:096742,F:097741; empty = use the list")
string finGroup = input.string("Leveraged Funds", "Big money in Financial markets", options = ["Leveraged Funds", "Asset Manager", "Dealer", "Other Reportable"], group = G_COT,
     tooltip = "Indices, currencies, crypto (spec §6.2, §13 q8)")
string disGroup = input.string("Managed Money", "Big money in commodities", options = ["Managed Money", "Producer Merchant", "Swap"], group = G_COT,
     tooltip = "Gold, silver, oil, gas, platinum (spec §6.2, §13 q8)")
int    cotWeeks = input.int(156, "COT Index: weeks", minval = 26, maxval = 520, group = G_COT, tooltip = "Range for the 0–100 index; 156 = 3 years")

// ── Which volatility index belongs to this chart (spec §5.2) ──────────────────────────────────
// The list line for this ticker without "TICKER=", e.g. "CBOE:VIX1D|TVC:VIX"; "" if the ticker is not listed.
listEntry(string list, string ticker) =>
    string found = ""
    array<string> lines = str.split(list, "\n")
    for raw in lines
        string ln = str.upper(str.replace_all(str.replace_all(raw, " ", ""), "\r", ""))
        array<string> kv = str.split(ln, "=")
        if kv.size() == 2 and kv.get(0) == ticker
            found := kv.get(1)
    found

string        entry    = volForce != "" ? str.upper(str.replace_all(volForce, " ", "")) : listEntry(volList, str.upper(syminfo.ticker))
array<string> entryN   = str.split(entry, "/")
array<string> alts     = str.split(entryN.size() > 0 ? entryN.get(0) : "", "|")
string        volSymA  = alts.size() > 0 ? alts.get(0) : ""
string        volSymB  = alts.size() > 1 ? alts.get(1) : volSymA
bool          hasIndex = volSymA != ""
float         perYear  = entryN.size() > 1 ? nz(str.tonumber(entryN.get(1)), float(yearDays)) : float(yearDays)

// Latest index value at every chart bar: same timeframe, no lookahead, so nothing repaints. Without a listed index the
// chart's own symbol is requested instead (always valid) and ignored. A missing symbol gives na, not an error.
float idxA = request.security(hasIndex ? volSymA : syminfo.tickerid, timeframe.period, close, ignore_invalid_symbol = true)
float idxB = request.security(hasIndex ? volSymB : syminfo.tickerid, timeframe.period, close, ignore_invalid_symbol = true)

// ── Weekly big-money bias from the COT report (spec §6.2) ─────────────────────────────────────────
string        cotEntry = cotForce != "" ? str.upper(str.replace_all(cotForce, " ", "")) : listEntry(cotList, str.upper(syminfo.ticker))
array<string> cotLegs  = str.split(cotEntry, ",")
string        legA     = cotLegs.size() > 0 ? cotLegs.get(0) : ""
string        legB     = cotLegs.size() > 1 ? cotLegs.get(1) : ""
bool          hasA     = str.length(legA) > 2
bool          hasB     = str.length(legB) > 2

// TradingView's COT ticker for one leg ("F:13874A"); the chart's own symbol stands in for a missing leg and is ignored.
cotTicker(string leg, string direction) =>
    if str.length(leg) > 2
        string report = str.substring(leg, 0, 1) == "D" ? "Disaggregated" : "Financial"
        string metric = (report == "Financial" ? finGroup : disGroup) + " Positions"
        cot.COTTickerid(report, str.substring(leg, 2), false, metric, direction, "All")
    else
        syminfo.tickerid

string longA  = cotTicker(legA, "Long")
string shortA = cotTicker(legA, "Short")
string longB  = cotTicker(legB, "Long")
string shortB = cotTicker(legB, "Short")

// One leg on the weekly timeframe: COT Index 0–100 = where the net position (long − short) sits in its range of the
// last cotWeeks weeks; also last week's index and the report's time.
cotLeg(string longT, string shortT) =>
    float lng = request.security(longT, "W", close, ignore_invalid_symbol = true)
    float sht = request.security(shortT, "W", close, ignore_invalid_symbol = true)
    int   rep = request.security(longT, "W", time, ignore_invalid_symbol = true)
    float net = lng - sht
    float hi  = ta.highest(net, cotWeeks)
    float lo  = ta.lowest(net, cotWeeks)
    float idx = na(net) or na(hi) or na(lo) ? na : hi == lo ? 50.0 : (net - lo) / (hi - lo) * 100
    [idx, idx[1], rep]

cotBoth() =>
    [iA, pA, tA] = cotLeg(longA, shortA)
    [iB, pB, tB] = cotLeg(longB, shortB)
    [iA, pA, tA, iB, pB, tB]

// Requested on the chart symbol's weekly bars without lookahead: a week's report reaches past bars only when that week has
// closed (after the Friday release), so nothing is used before it was published (spec §6.2).
[cotIA, cotPA, cotTA, cotIB, cotPB, cotTB] = request.security(syminfo.tickerid, "W", cotBoth())

// Score: one leg = its index (0–100); a cross = base − quote (−100 … +100); an empty base = the quote leg turned round.
bool  cotCross = hasA and hasB
float cotNow   = cotCross ? cotIA - cotIB : hasA ? cotIA : hasB ? 100 - cotIB : na
float cotPrev  = cotCross ? cotPA - cotPB : hasA ? cotPA : hasB ? 100 - cotPB : na
int   cotTime  = hasA ? cotTA : cotTB

cotWords(float now, float prev, bool cross) =>
    float hiX = cross ? 60.0 : 90.0     // crowded long at or above
    float hiB = cross ? 20.0 : 60.0     // buying at or above, while rising
    float loB = cross ? -20.0 : 40.0    // selling at or below, while falling
    float loX = cross ? -60.0 : 10.0    // crowded short at or below
    bool rising  = not na(prev) and math.round(now) > math.round(prev)   // whole numbers, as shown
    bool falling = not na(prev) and math.round(now) < math.round(prev)
    na(now) ? "" : now >= hiX ? "Crowded long — late to buy" : now >= hiB and rising ? "Buying" :
         now <= loX ? "Crowded short — late to sell" : now <= loB and falling ? "Selling" : "Neutral"

cotText() =>
    if not (hasA or hasB)
        "no COT market listed"
    else if na(cotNow)
        "no COT data for " + cotEntry
    else
        string arrow = na(cotPrev) or math.round(cotNow) == math.round(cotPrev) ? "→" : cotNow > cotPrev ? "↑" : "↓"
        string value = cotCross ? (cotNow >= 0 ? "+" : "") + str.tostring(cotNow, "0") : str.tostring(cotNow, "0")
        cotWords(cotNow, cotPrev, cotCross) + "  (COT " + value + " " + arrow + ", " + str.format_time(cotTime + 86400000, "dd-MMM", "UTC") + ")"   // weekly bar opens Monday; the report is Tuesday's

// ── Historical σ: Yang–Zhang over the last n completed days (spec §5.3) ─────────────────────────
yangZhang(int n) =>
    float o = math.log(open / close[1])   // overnight / weekend gap
    float c = math.log(close / open)      // open to close
    float u = math.log(high / open)
    float d = math.log(low / open)
    float k = 0.34 / (1.34 + (n + 1.0) / (n - 1.0))
    float v = ta.variance(o, n, false) + k * ta.variance(c, n, false) + (1 - k) * ta.sma(u * (u - c) + d * (d - c), n)
    math.sqrt(v)

// [1] with lookahead on = the value of the last completed day, the same for every bar of today (no repainting).
float sigHist = request.security(syminfo.tickerid, "D", yangZhang(histDays)[1], lookahead = barmerge.lookahead_on)

// ── The day's anchor and implied σ, fixed when the chart's day starts (spec §5.1, §5.2) ────────────
bool newDay = timeframe.change("D")

var float  dayOpen   = na
var float  dayIdx    = na
var string dayIdxSym = ""
if newDay
    dayOpen := open
    float a = idxA[1]   // last index value before this day began (e.g. VIX's 16:15 New York close)
    float b = idxB[1]
    dayIdx    := not hasIndex ? na : not na(a) ? a : b
    dayIdxSym := not hasIndex ? "" : not na(a) ? volSymA : not na(b) ? volSymB : ""

float sigImp = na(dayIdx) ? na : dayIdx / 100.0 / math.sqrt(perYear)

string srcName = switch srcMode
    "Implied only"    => "implied"
    "Historical only" => "historical"
    => na(sigImp) ? "historical" : "implied"
float sigma = srcName == "implied" ? sigImp : sigHist

float up1 = dayOpen * math.exp(sigma)
float dn1 = dayOpen * math.exp(-sigma)
float up2 = dayOpen * math.exp(2 * sigma)
float dn2 = dayOpen * math.exp(-2 * sigma)

// ── Lines: one step per day, with a gap at each day start (spec §5.1) ──────────────────────────────
bool draw = timeframe.isintraday and not newDay
plot(draw ? dayOpen : na, "Open", colOpen, 1, plot.style_linebr)
plot(draw ? up1 : na, "+1σ", col1, 2, plot.style_linebr)
plot(draw ? dn1 : na, "−1σ", col1, 2, plot.style_linebr)
plot(draw and show2 ? up2 : na, "+2σ", col2, 1, plot.style_linebr)
plot(draw and show2 ? dn2 : na, "−2σ", col2, 1, plot.style_linebr)

// ── Table (spec §5.5) ───────────────────────────────────────────────────────────────────────────
fmtPct(float x) => na(x) ? "—" : str.tostring(x * 100, "0.00") + " %"
fmtPx(float x) => na(x) ? "—" : str.tostring(x, format.mintick)

var table tbl = table.new(position.top_right, 2, 7, bgcolor = color.new(color.gray, 85), border_width = 1)

cell(int row, string label, string value) =>
    table.cell(tbl, 0, row, label, text_color = chart.fg_color, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, row, value, text_color = chart.fg_color, text_size = size.small, text_halign = text.align_right)

if showTable and barstate.islast
    if not timeframe.isintraday
        cell(0, "Levels", "range: use an intraday chart")
        if showCot
            cell(1, "Big money", cotText())
    else
        string srcText   = srcName == "implied" ? "implied " + dayIdxSym + " " + str.tostring(dayIdx, "0.00") : "historical " + str.tostring(histDays) + " d"
        string otherText = srcName == "implied" ? "historical " + fmtPct(sigHist) :
             not hasIndex ? "implied: no index listed" :
             na(sigImp) ? "implied: no data for " + entry : "implied " + fmtPct(sigImp)
        float  nowSig    = na(sigma) or sigma == 0 ? na : math.log(close / dayOpen) / sigma
        cell(0, "Source", srcText)
        cell(1, "σ", fmtPct(sigma) + "  (" + fmtPx(dayOpen * sigma) + ")")
        cell(2, "±1σ", fmtPx(dn1) + " – " + fmtPx(up1))
        cell(3, "±2σ", show2 ? fmtPx(dn2) + " – " + fmtPx(up2) : "hidden")
        cell(4, "Now", na(nowSig) ? "—" : (nowSig >= 0 ? "+" : "") + str.tostring(nowSig, "0.0") + "σ from open")
        cell(5, "Compare", otherText)
        if showCot
            cell(6, "Big money", cotText())
